# Kopiraj u .env.local (gitignored) za lokalni razvoj s cloud značajkama
# (računi, sinkronizacija, leaderboard, PvP). Bez ovih varijabli app radi
# potpuno normalno u guest/samo-lokalnom modu - nisu obavezne.
#
# Vrijednosti: Supabase Dashboard -> Project Settings -> API.
# Oboje je namijenjeno javnoj/frontend upotrebi (anon key je zaštićen RLS
# politikama u bazi, nije tajna) - u CI-u idu kao GitHub repo Variables,
# ne Secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
